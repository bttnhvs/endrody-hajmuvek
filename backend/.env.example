# Másold le ezt a fájlt .env néven, és töltsd ki.
# A .env NEM kerül gitbe (titkos adatok vannak benne).

PORT=3001

# Élesben (Render, Railway stb. mögött) állítsd true-ra, hogy a rate limit a valódi IP-t lássa.
TRUST_PROXY=false

# Melyik címről hívhatja a böngésző az API-t (vesszővel több is megadható).
CORS_ORIGIN=http://localhost:4201

# --- Adatbázis ---
# Fejlesztéshez semmit nem kell beállítani: egy SQLite fájlba ment (data/hajmuvek.sqlite).
# Élesben adj meg egy PostgreSQL kapcsolatot (pl. a Neon vagy a Render ingyenes csomagjából):
# DATABASE_URL=postgres://felhasznalo:jelszo@host:5432/hajmuvek
# A táblákat a kód alapján automatikusan létrehozza. Élesben, ha már vannak valódi adatok,
# érdemes kikapcsolni és migrációkra váltani (lásd TANULAS-BACKEND.md).
DB_SYNC=true

# --- Admin hozzáférés ---
# Ezzel a tokennel lehet lekérni az ajánlatkéréseket. Legyen hosszú és véletlenszerű,
# pl.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=cserelj-le-egy-hosszu-veletlen-szovegre

# --- E-mail (Resend, nem kötelező) ---
# Ha nincs megadva RESEND_API_KEY, az e-maileket csak kiírja a konzolra ("száraz mód").
# Kulcs: https://resend.com → regisztráció → API Keys → Create API Key (re_ kezdetű).
# FIGYELEM: saját, a Resendben ellenőrzött domain nélkül csak a Resend-fiók saját
# e-mail-címére lehet küldeni – ezért a fiókot azzal a címmel regisztráld, ami a MAIL_TO-ban van.
RESEND_API_KEY=

# Feladó. Domain nélkül hagyd üresen (ekkor: onboarding@resend.dev).
# Ha a domain ellenőrizve van a Resendben: MAIL_FROM="Endrődy Hajművek <hello@hajmuvek.hu>"
MAIL_FROM=

# Ide érkezik az értesítés minden új ajánlatkérésről:
MAIL_TO=hello@hajmuvek.hu

# Kapjon-e a vevő automatikus visszaigazolást? Csak ellenőrzött domainnel kapcsold be (true).
MAIL_CONFIRM_TO_CUSTOMER=false
